---
import DefaultHead from '@astrojs/starlight/components/Head.astro';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
// Do not emit the framework's default icon URL when no such asset exists.
// A future supplied public favicon is retained; no artwork is generated here.
if (!existsSync(resolve('public/favicon.svg'))) {
  Astro.locals.starlightRoute.head = Astro.locals.starlightRoute.head.filter(entry =>
    !(entry.tag === 'link' && entry.attrs?.rel === 'shortcut icon' && entry.attrs.href === '/favicon.svg')
  );
}
---
<DefaultHead {...Astro.props} />
<noscript set:html={'<style>.page>header.header{position:static}.main-frame{padding-top:0}mobile-starlight-toc nav{position:static}site-search,starlight-menu-button,starlight-theme-select{display:none}</style>'} />
<script is:inline>
  (() => {
    const root = document.documentElement;
    const sync = () => {
      root.dataset.cibcTheme = root.dataset.theme === 'dark' ? 'dark' : 'light';
    };
    sync();
    new MutationObserver(sync).observe(root, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  })();
</script>
<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>('header.header');
  if (header) {
    const syncHeight = () => {
      const height = Math.ceil(header.getBoundingClientRect().height);
      if (height > 0 && root.style.getPropertyValue('--sl-nav-height') !== `${height}px`) {
        root.style.setProperty('--sl-nav-height', `${height}px`);
      }
    };
    new ResizeObserver(syncHeight).observe(header);
    syncHeight();
  }

  const contents = document.querySelector<HTMLElement>('mobile-starlight-toc summary');
  if (contents) {
    const syncContentsHeight = () => {
      const height = Math.ceil(contents.getBoundingClientRect().height);
      if (height > 0) {
        if (root.style.getPropertyValue('--sl-mobile-toc-height') !== `${height}px`) {
          root.style.setProperty('--sl-mobile-toc-height', `${height}px`);
        }
      } else {
        root.style.removeProperty('--sl-mobile-toc-height');
      }
    };
    // Observe the closed control, not the dropdown: opening contents must not
    // push the article down by the height of the entire heading list.
    new ResizeObserver(syncContentsHeight).observe(contents);
    syncContentsHeight();
  }

  const menu = document.querySelector('starlight-menu-button');
  if (menu) {
    const syncExpanded = () => menu.querySelector('button')?.setAttribute(
      'aria-expanded', menu.getAttribute('aria-expanded') === 'true' ? 'true' : 'false'
    );
    new MutationObserver(syncExpanded).observe(menu, { attributes: true, attributeFilter: ['aria-expanded'] });
    syncExpanded();
  }

  const search = document.querySelector('site-search');
  if (search) {
    const labelControls = () => {
      const input = search.querySelector('input.pagefind-ui__search-input');
      if (input && !input.hasAttribute('aria-label')) {
        input.setAttribute('aria-label', search.querySelector('[data-open-modal]')?.getAttribute('aria-label') || 'Search');
      }
      const clear = search.querySelector('button.pagefind-ui__search-clear');
      if (clear && !clear.hasAttribute('aria-label')) clear.setAttribute('aria-label', clear.textContent?.trim() || 'Clear search');
    };
    new MutationObserver(labelControls).observe(search, { childList: true, subtree: true });
    labelControls();
  }
</script>
